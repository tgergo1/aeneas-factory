{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "rootDir": ".",
    "outDir": "out-test",
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*.ts", "media/**/*.ts", "test/**/*.ts"]
}
