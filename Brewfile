# Explicit (code-driven) creative tools for aeneas-factory: `brew bundle --file=Brewfile` (or `make explicit`).
# None of these downloads model weights. Licences as Homebrew reports them.
# Also used, installed separately: Blender and Godot (in /Applications).

# runtimes for the Node and .NET tools
brew "node"             # MIT
brew "dotnet"           # MIT: Yarn Spinner's compiler

# images and graphics
brew "imagemagick"      # ImageMagick licence: batch editing, compositing, colour work
brew "graphviz"         # EPL-1.0: diagrams from text
brew "d2"               # MPL-2.0: diagrams from text
brew "resvg"            # MPL-2.0: SVG rendering
brew "librsvg"          # LGPL-2.1: rsvg-convert, a second SVG renderer
# FontForge: its Homebrew cask is disabled (fails the macOS Gatekeeper check, 2026-09-01); fontTools (Python) builds fonts instead.

# music and sound
brew "fluid-synth"      # LGPL-2.1: MIDI to audio with SoundFonts
brew "abcmidi"          # GPL-2.0: ABC notation to MIDI
brew "lilypond"         # GPL-3.0: music notation to PDF and MIDI
brew "csound"           # LGPL-2.1: sound design as code, offline rendering
brew "faust"            # GPL-2.0 (compiler; output is yours): DSP as code
brew "sox"              # GPL-2.0 / LGPL-2.1: audio effects and conversion
brew "lame"             # LGPL-2.0: MP3 encoder library; faust2sndfile links against it
cask "supercollider"    # GPL-3.0: synthesis and algorithmic composition

# 3D
cask "openscad@snapshot"  # GPL-2.0: solid models as code
brew "basis_universal"  # Apache-2.0: GPU texture compression (KTX2/Basis)
brew "colmap"           # BSD-3: photogrammetry (3D from your own photos)

# levels
cask "tiled"            # GPL-2.0 (editor; maps are yours): tile map editor with command-line export
