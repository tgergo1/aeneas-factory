#!/usr/bin/env python3
"""Make an image from a prompt with a local model (stable-diffusion.cpp on Metal).

  ai-image "a thatched cottage at dusk, oil painting" -o cottage.png
  ai-image "..." --model flux2-klein-4b --size 768 --seed 7 -o out.png
  ai-image "paint the chest bright blue" --model flux2-klein-4b --ref chest.png -o blue.png   # edit
  ai-image "mossy cobblestones, top-down" --tile --size 512 -o cobbles.png                   # seamless tile
  ai-image "weathered oak planks" --init photo.png --strength 0.4 -o oak.png                 # image to image

Writes out.png, out.png.json (models, licences, prompt, seed, settings) and out.png.log.
Anything after `--` goes to sd-cli unchanged.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _ailib as ai  # noqa: E402

TEXT_ENCODER = ("z-image-turbo", "Qwen3-4B-Instruct-2507-Q8_0.gguf")
PRESETS = {
    # model id: (sd-cli model arguments, default steps, default cfg)
    "z-image-turbo": (lambda: ["--diffusion-model", ai.model_path("z-image-turbo", "z_image_turbo-Q8_0.gguf"),
                               "--llm", ai.model_path(*TEXT_ENCODER),
                               "--vae", ai.model_path("z-image-turbo", "ae.safetensors")], 8, 1.0),
    "flux2-klein-4b": (lambda: ["--diffusion-model", ai.model_path("flux2-klein-4b", "flux-2-klein-4b-Q8_0.gguf"),
                                "--llm", ai.model_path(*TEXT_ENCODER),
                                "--vae", ai.model_path("flux2-klein-4b", "flux2_vae.safetensors")], 4, 1.0),
}


def main():
    argv, extra = sys.argv[1:], []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("prompt")
    ap.add_argument("-o", "--out", required=True, help="output .png")
    ap.add_argument("--model", choices=sorted(PRESETS), default="z-image-turbo")
    ap.add_argument("--size", type=int, default=1024, help="square size in pixels (default 1024)")
    ap.add_argument("-W", "--width", type=int)
    ap.add_argument("-H", "--height", type=int)
    ap.add_argument("--steps", type=int, help="default 8 for z-image-turbo, 4 for flux2-klein-4b")
    ap.add_argument("--cfg", type=float)
    ap.add_argument("--seed", type=int, help="default: a random seed, recorded in the sidecar")
    ap.add_argument("--neg", help="negative prompt")
    ap.add_argument("--init", help="start from this image (image to image)")
    ap.add_argument("--strength", type=float, default=0.6, help="with --init: how far to move from it (0-1)")
    ap.add_argument("--ref", action="append", default=[], help="reference image to edit (flux2-klein-4b); repeatable")
    ap.add_argument("--tile", action="store_true", help="seamless tiling (sd-cli --circular)")
    ap.add_argument("--gpu-vae", action="store_true",
                    help="decode on the GPU; by default the VAE decodes on the CPU, as the Metal decode can come out blank")
    a = ap.parse_args(argv)

    ai.require_tool(ai.SD_CLI, "sd")
    ai.require_model(a.model)
    ai.require_model(TEXT_ENCODER[0])
    args, steps, cfg = PRESETS[a.model]
    seed = a.seed if a.seed is not None else ai.new_seed()
    out = Path(a.out).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    w, h = a.width or a.size, a.height or a.size
    steps = a.steps or steps
    cfg = a.cfg if a.cfg is not None else cfg

    cmd = [ai.SD_CLI, *args(), "-p", a.prompt, "--cfg-scale", str(cfg), "--steps", str(steps),
           "-W", str(w), "-H", str(h), "--seed", str(seed), "-o", out]
    if a.neg:
        cmd += ["-n", a.neg]
    if a.init:
        cmd += ["-i", Path(a.init).resolve(), "--strength", str(a.strength)]
    for r in a.ref:
        cmd += ["-r", Path(r).resolve()]
    if a.tile:
        cmd += ["--circular"]
    if not a.gpu_vae:
        cmd += ["--backend", "vae=cpu"]
    cmd += extra

    started = ai.now()
    ai.run(cmd, out.with_name(out.name + ".log"))
    if not out.exists() or out.stat().st_size < 1000:
        sys.exit(f"sd-cli finished but wrote no image at {ai.portable(out)}")
    used = [a.model] + ([TEXT_ENCODER[0]] if a.model != TEXT_ENCODER[0] else [])
    side = ai.write_sidecar(out, "ai-image", used, cmd, started, prompt=a.prompt, negative_prompt=a.neg, seed=seed,
                            params={"width": w, "height": h, "steps": steps, "cfg": cfg, "tile": a.tile or None,
                                    "strength": a.strength if a.init else None},
                            inputs=([a.init] if a.init else []) + a.ref)
    print(f"{ai.portable(out)}  ({ai.portable(side)})")


if __name__ == "__main__":
    main()
