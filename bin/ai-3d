#!/usr/bin/env python3
"""Make a textured 3D model (.glb) from one image with TRELLIS.2 (trellis.cpp on Metal).

  ai-3d chest.png -o chest.glb
  ai-3d chest.png -o chest.glb --res 512 --seed 3        # lighter and faster
  ai-3d chest.png -o chest.glb --no-texture              # geometry only

Writes out.glb, out.glb.json (models, licences, the input image and its checksum, settings)
and out.glb.log; trellis.cpp also leaves <name>.ply and <name>_base.png beside it.
Anything after `--` goes to trellis-cli unchanged (--decim, --atlas, --box-uv, ...).
One object on a plain or transparent background works best; BiRefNet mattes the rest.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _ailib as ai  # noqa: E402


def main():
    argv, extra = sys.argv[1:], []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("image")
    ap.add_argument("-o", "--out", required=True, help="output .glb")
    ap.add_argument("--res", choices=["512", "1024", "1536"], default="1024")
    ap.add_argument("--seed", type=int)
    ap.add_argument("--no-texture", action="store_true")
    ap.add_argument("--bg-removal", choices=["threshold", "birefnet"])
    a = ap.parse_args(argv)

    ai.require_tool(ai.TRELLIS_CLI, "trellis")
    ai.require_model("trellis2")
    image = Path(a.image).resolve()
    if not image.exists():
        sys.exit(f"no such image: {a.image}")
    out = Path(a.out).resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    seed = a.seed if a.seed is not None else ai.new_seed()

    cmd = [ai.TRELLIS_CLI, "--image", image, "--output", out, "--models", ai.model_path("trellis2"),
           "--res", a.res, "--seed", str(seed)]
    if a.no_texture:
        cmd += ["--no-texture"]
    if a.bg_removal:
        cmd += ["--bg-removal", a.bg_removal]
    cmd += extra

    started = ai.now()
    ai.run(cmd, out.with_name(out.name + ".log"))
    if not out.exists() or out.stat().st_size < 1000:
        sys.exit(f"trellis-cli finished but wrote no model at {ai.portable(out)}")
    side = ai.write_sidecar(out, "ai-3d", ["trellis2"], cmd, started, seed=seed,
                            params={"res": a.res, "texture": not a.no_texture, "bg_removal": a.bg_removal or "auto"},
                            inputs=[image])
    print(f"{ai.portable(out)}  ({ai.portable(side)})")


if __name__ == "__main__":
    main()
